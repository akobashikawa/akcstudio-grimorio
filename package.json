{
  "name": "akcstudio-grimorio",
  "type": "module",
  "version": "1.0.0",
  "description": "Blog personal bilingüe (inglés/español) construido con Astro, Vue y Tailwind CSS y desplegado en Cloudflare Workers.",
  "license": "MIT",
  "homepage": "https://akcstudio-grimorio.akobashikawa.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/akobashikawa/akcstudio-grimorio.git"
  },
  "keywords": [
    "astro",
    "blog",
    "bilingual",
    "i18n",
    "vue",
    "tailwindcss",
    "cloudflare-workers"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "deploy": "pnpm build && wrangler deploy",
    "smoke": "node scripts/smoke-test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro sync && astro check && vue-tsc --noEmit",
    "test": "pnpm build && playwright test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-types": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.141",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "^0.59.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.0 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "@tailwindcss/typography>postcss-selector-parser": "^7.1.6"
    }
  }
}
